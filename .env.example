# Scanner
PORT=3001
HOST=0.0.0.0
# Visitatore: siti diversi al giorno (la rianalisi dello stesso sito non consuma quota)
RATE_LIMIT_PER_DAY=2
# Limite globale anti abuso: scansioni totali per ora
GLOBAL_SCANS_PER_HOUR=30
SCAN_CONCURRENCY=1
SCAN_MAX_QUEUE=10
SCAN_TIMEOUT_MS=60000
# Obbligatorio in produzione: stringa casuale lunga (es. openssl rand -hex 32)
FINGERPRINT_SALT=
# Percorso del database SQLite (rate limit e, in futuro, lead)
DATABASE_PATH=./data/semaforo.sqlite
# true se il servizio sta dietro nginx (legge X-Forwarded-For)
TRUST_PROXY=false
PUBLIC_BASE_URL=http://localhost:3000
# Browser (Chromium via Playwright) per i controlli su cookie e tracciamento
BROWSER_ENABLED=true
# Sandbox di Chromium: attivarlo in produzione (serve un container che lo supporti, vedi Milestone 5)
CHROMIUM_SANDBOX=false
# Facoltativo: percorso di un Chromium diverso da quello di Playwright
CHROMIUM_EXECUTABLE_PATH=

# Lead dal modulo contatti: inoltrati via email all'autore e cancellati dal database dopo N ore
LEAD_RETENTION_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_TO=
PAGESPEED_API_KEY=

# Sito (apps/web). I dati del titolare compaiono nel footer e nella privacy policy:
# finché sono vuoti si vedono come [PLACEHOLDER].
OWNER_NAME=
OWNER_VAT=
OWNER_ADDRESS=
OWNER_EMAIL=
OWNER_PEC=
# Solo per sviluppo e test: in produzione /api è instradato da nginx. Letto alla BUILD di Next.
SCANNER_INTERNAL_URL=http://127.0.0.1:3001
