{
  "name": "@semaforo/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "bench": "tsx scripts/bench-browser.ts"
  },
  "dependencies": {
    "@semaforo/shared": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.2.0",
    "playwright": "1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
